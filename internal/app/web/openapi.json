{
  "openapi": "3.1.0",
  "info": {
    "title": "小苹果邮箱 API",
    "version": "1.0.0",
    "description": "小苹果邮箱的管理 API、临时邮箱租约 API 与单邮箱取码 API。管理接口使用 Session Cookie 和 CSRF；公共接口使用具名 API Key。"
  },
  "servers": [{"url": "/", "description": "当前部署"}],
  "tags": [
    {"name": "Admin", "description": "单管理员后台接口"},
    {"name": "Leases", "description": "临时邮箱租约接口"},
    {"name": "Mailbox code", "description": "单邮箱取码接口"}
  ],
  "components": {
    "securitySchemes": {
      "adminSession": {"type": "apiKey", "in": "cookie", "name": "sam_session"},
      "csrf": {"type": "apiKey", "in": "header", "name": "X-CSRF-Token"},
      "apiKey": {"type": "http", "scheme": "bearer", "bearerFormat": "sam_live_..."},
      "leaseToken": {"type": "apiKey", "in": "header", "name": "X-Lease-Token", "description": "创建租约时返回的 sam_lease_... Token"},
      "mailboxKey": {"type": "apiKey", "in": "query", "name": "key", "description": "轮换单邮箱凭据时返回的 sam_mailbox_... Key"}
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "retryable", "request_id"],
        "properties": {
          "code": {"type": "string", "example": "invalid_request"},
          "message": {"type": "string", "example": "请求参数无效"},
          "retryable": {"type": "boolean", "example": false},
          "request_id": {"type": "string", "example": "req_example"},
          "details": {"type": "object", "additionalProperties": true}
        }
      },
      "ErrorEnvelope": {"type": "object", "required": ["error"], "properties": {"error": {"$ref": "#/components/schemas/ErrorDetail"}}},
      "DataEnvelope": {"type": "object", "required": ["data"], "properties": {"data": {}}, "additionalProperties": false},
      "LeaseCreateRequest": {
        "type": "object",
        "properties": {
          "project": {"type": "string", "maxLength": 100, "example": "signup-tests"},
          "purpose": {"type": "string", "maxLength": 200, "example": "接收注册验证码"},
          "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 1800}
        }
      },
      "LeaseRenewRequest": {"type": "object", "properties": {"ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400, "default": 1800}}},
      "Lease": {
        "type": "object",
        "required": ["id", "mailbox_id", "email", "status", "expires_at"],
        "properties": {
          "id": {"type": "string", "example": "lea_example"},
          "mailbox_id": {"type": "string", "example": "mbx_example"},
          "email": {"type": "string", "format": "email", "example": "example@icloud.com"},
          "project": {"type": "string"},
          "purpose": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "released", "expired", "revoked"]},
          "created_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "lease_token": {"type": "string", "description": "仅在首次创建时返回", "example": "sam_lease_example"}
        }
      },
      "CodeResult": {
        "type": "object",
        "required": ["code", "received_at", "message_id"],
        "properties": {
          "code": {"type": "string", "example": "123456"},
          "sender": {"type": "string", "example": "no-reply@example.com"},
          "subject": {"type": "string"},
          "received_at": {"type": "string", "format": "date-time"},
          "message_id": {"type": "string"},
          "consumed": {"type": "boolean"},
          "synced_for_request": {"type": "boolean"}
        }
      },
      "ActivityInput": {
        "type": "object",
        "required": ["type", "result"],
        "properties": {
          "type": {"type": "string", "example": "manual.note"},
          "result": {"type": "string", "enum": ["success", "failed"]},
          "detail": {"type": "string", "example": "人工维护记录"}
        }
      },
      "Activity": {
        "allOf": [
          {"$ref": "#/components/schemas/ActivityInput"},
          {"type": "object", "required": ["id", "source", "created_at"], "properties": {
            "id": {"type": "integer", "format": "int64"},
            "source": {"type": "string", "enum": ["system", "manual"]},
            "entity_type": {"type": "string"},
            "entity_id": {"type": "string"},
            "request_id": {"type": "string"},
            "remote_ip": {"type": "string"},
            "created_at": {"type": "string", "format": "date-time"}
          }}
        ]
      },
      "MailboxPatch": {"type": "object", "properties": {"label": {"type": "string", "maxLength": 120}, "note": {"type": "string", "maxLength": 2000}, "tags": {"type": "array", "items": {"type": "string"}}, "allocation_mode": {"type": "string", "enum": ["shared", "dedicated"], "description": "临时分配或长期专用；专用邮箱不参与租约分配"}, "purpose": {"type": "string", "maxLength": 120}, "local_enabled": {"type": "boolean", "description": "是否允许新的租约分配，不改变远端转发或中断现有租约"}}}
    },
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 200}, "example": "request-20260719-001"},
      "LeaseID": {"name": "lease_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "MailboxID": {"name": "mailbox_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "After": {"name": "after", "in": "query", "required": false, "schema": {"type": "string", "format": "date-time"}},
      "Keyword": {"name": "keyword", "in": "query", "schema": {"type": "string", "maxLength": 100}},
      "WaitSeconds": {"name": "wait_seconds", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 30, "default": 0}}
    },
    "responses": {
      "BadRequest": {"description": "请求参数无效", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Unauthorized": {"description": "凭据无效", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Forbidden": {"description": "权限或 CSRF 校验失败", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "NotFound": {"description": "资源不存在", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}},
      "Conflict": {"description": "资源状态冲突、邮箱池为空或幂等冲突", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}
    }
  },
  "paths": {
    "/api/admin/session": {
      "post": {"tags": ["Admin"], "summary": "管理员登录", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["username", "password"], "properties": {"username": {"type": "string"}, "password": {"type": "string", "format": "password"}}}}}}, "responses": {"200": {"description": "登录成功"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "get": {"tags": ["Admin"], "summary": "读取当前会话", "security": [{"adminSession": []}], "responses": {"200": {"description": "当前管理员与 CSRF Token"}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "delete": {"tags": ["Admin"], "summary": "退出登录", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "已退出"}}}
    },
    "/api/admin/password": {"put": {"tags": ["Admin"], "summary": "修改管理员密码", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "密码已修改"}}}},
    "/api/admin/dashboard": {"get": {"tags": ["Admin"], "summary": "读取仪表盘摘要", "security": [{"adminSession": []}], "responses": {"200": {"description": "运行摘要"}}}},
    "/api/admin/accounts": {"get": {"tags": ["Admin"], "summary": "账号列表", "security": [{"adminSession": []}], "responses": {"200": {"description": "账号列表"}}}, "post": {"tags": ["Admin"], "summary": "新增账号", "security": [{"adminSession": [], "csrf": []}], "responses": {"201": {"description": "账号已创建"}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/api/admin/accounts/{account_id}": {"parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}], "get": {"tags": ["Admin"], "summary": "读取账号", "security": [{"adminSession": []}], "responses": {"200": {"description": "账号详情"}}}, "patch": {"tags": ["Admin"], "summary": "编辑账号", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "账号已更新"}}}, "delete": {"tags": ["Admin"], "summary": "删除账号", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "账号已删除"}}}},
    "/api/admin/accounts/{account_id}/delete-preview": {"get": {"tags": ["Admin"], "summary": "预览账号删除影响", "security": [{"adminSession": []}], "parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "删除影响及确认 Token"}}}},
    "/api/admin/accounts/{account_id}/connections": {"get": {"tags": ["Admin"], "summary": "账号连接列表", "security": [{"adminSession": []}], "parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "连接列表，含 last_checked_at、expires_at、next_check_at、consecutive_failures；不返回连接凭据。expired 表示需要重新登录且自动维护暂停。"}}}},
    "/api/admin/accounts/{account_id}/connections/{kind}": {"parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "kind", "in": "path", "required": true, "schema": {"type": "string", "enum": ["apple_account", "icloud_web", "imap"]}}], "put": {"tags": ["Admin"], "summary": "保存连接", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "连接已保存或等待 2FA"}}}, "delete": {"tags": ["Admin"], "summary": "删除连接", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "连接已删除"}}}},
    "/api/admin/accounts/{account_id}/connections/{kind}/verify": {"post": {"tags": ["Admin"], "summary": "提交连接 2FA", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "kind", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "连接验证成功"}}}},
    "/api/admin/accounts/{account_id}/connections/{kind}/enabled": {"patch": {"tags": ["Admin"], "summary": "启用或停用备用创建通道，保留凭据", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "kind", "in": "path", "required": true, "schema": {"type": "string", "enum": ["apple_account"]}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "返回连接公开状态，不含凭据"}, "400": {"description": "无效参数或通道"}, "404": {"description": "尚未配置备用创建通道"}}}},
    "/api/admin/accounts/{account_id}/connections/{kind}/check": {"post": {"tags": ["Admin"], "summary": "创建连接检测任务", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "account_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "kind", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "任务已创建"}}}},
    "/api/admin/mailboxes": {"get": {"tags": ["Admin"], "summary": "分页查询邮箱", "security": [{"adminSession": []}], "parameters": [{"name": "cursor", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200}}, {"name": "query", "in": "query", "schema": {"type": "string"}}, {"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "account_id", "in": "query", "schema": {"type": "string"}}, {"name": "allocation_mode", "in": "query", "description": "按 shared 或 dedicated 筛选", "schema": {"type": "string"}}, {"name": "tag", "in": "query", "description": "精确标签，不区分大小写", "schema": {"type": "string"}}, {"name": "with_result", "in": "query", "description": "仅返回已有验证码或登录链接的邮箱", "schema": {"type": "boolean"}}, {"name": "unused", "in": "query", "description": "仅返回从未分配过租约的临时邮箱", "schema": {"type": "boolean"}}], "responses": {"200": {"description": "分页邮箱列表；last_login_url 和 last_login_url_at 为最近提取的 Claude 登录链接及收件时间，仅作为文本返回"}}}, "post": {"tags": ["Admin"], "summary": "登记邮箱", "security": [{"adminSession": [], "csrf": []}], "responses": {"201": {"description": "邮箱已登记"}}, "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["account_id", "email"], "properties": {"label": {"type": "string", "maxLength": 120}, "note": {"type": "string", "maxLength": 2000}, "tags": {"type": "array", "items": {"type": "string"}}, "allocation_mode": {"type": "string", "enum": ["shared", "dedicated"], "description": "临时分配或长期专用；专用邮箱不参与租约分配"}, "purpose": {"type": "string", "maxLength": 120}, "account_id": {"type": "string"}, "email": {"type": "string", "format": "email"}}}}}}}},
    "/api/admin/mailbox-sync-previews": {"post": {"tags": ["Admin"], "summary": "预览远端邮箱同步", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "同步预览及确认 Token"}}}},
    "/api/admin/mailbox-sync-jobs": {"post": {"tags": ["Admin"], "summary": "确认并创建远端邮箱同步任务", "security": [{"adminSession": [], "csrf": []}], "responses": {"202": {"description": "任务已创建"}}}},
    "/api/admin/mailbox-clean-previews": {"post": {"tags": ["Admin"], "summary": "预览远端消息清理", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "清理预览及确认 Token"}}}},
    "/api/admin/mailbox-clean-jobs": {"post": {"tags": ["Admin"], "summary": "确认并创建远端消息清理任务", "security": [{"adminSession": [], "csrf": []}], "responses": {"202": {"description": "任务已创建"}}}},
    "/api/admin/mailboxes/{mailbox_id}": {"parameters": [{"$ref": "#/components/parameters/MailboxID"}], "get": {"tags": ["Admin"], "summary": "读取邮箱", "security": [{"adminSession": []}], "responses": {"200": {"description": "邮箱详情"}}}, "patch": {"tags": ["Admin"], "summary": "编辑邮箱", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "邮箱已更新"}}, "description": "仅修改提交的字段。存在活动租约时禁止切换用途类型；保留用途类型的备注和标签修改仍然允许。", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MailboxPatch"}}}}}, "delete": {"tags": ["Admin"], "summary": "删除邮箱", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "邮箱已删除"}}}},
    "/api/admin/messages": {"get": {"tags": ["Admin"], "summary": "分页汇总所有邮箱的本地邮件", "security": [{"adminSession": []}], "parameters": [{"name": "query", "in": "query", "schema": {"type": "string"}, "description": "搜索发件人、主题、收件邮箱地址或邮箱显示标签"}, {"name": "account_id", "in": "query", "schema": {"type": "string"}}, {"name": "kind", "in": "query", "schema": {"type": "string", "enum": ["", "code", "link", "ordinary"]}}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 20}}], "responses": {"200": {"description": "包含 items、total、page、page_size 和 pages；每条邮件包含 mailbox_email、account_id、account_name，不返回正文，不访问远端邮件服务"}, "400": {"description": "无效邮件类型"}, "401": {"description": "未登录"}}}},
    "/api/admin/mailboxes/{mailbox_id}/messages": {"get": {"tags": ["Admin"], "summary": "分页读取收件列表", "security": [{"adminSession": []}], "parameters": [{"$ref": "#/components/parameters/MailboxID"}, {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}}, {"name": "page_size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 10}}], "responses": {"200": {"description": "包含 items、total、page、page_size 和 pages 的收件分页；login_url 为离线提取的 Claude 登录链接，列表不返回正文"}}}},
    "/api/admin/mailboxes/{mailbox_id}/messages/{message_id}": {"get": {"tags": ["Admin"], "summary": "读取单封邮件及完整文本正文", "security": [{"adminSession": []}], "parameters": [{"$ref": "#/components/parameters/MailboxID"}, {"name": "message_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "邮件详情；login_url 为离线提取的 Claude 登录链接，不访问链接或加载远端资源"}, "404": {"description": "邮件不存在"}}}},
    "/api/admin/mailboxes/{mailbox_id}/message-sync-jobs": {"post": {"tags": ["Admin"], "summary": "创建邮箱消息同步任务", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"$ref": "#/components/parameters/MailboxID"}], "responses": {"202": {"description": "任务已创建"}}}},
    "/api/admin/mailboxes/{mailbox_id}/api-credential": {"post": {"tags": ["Admin"], "summary": "轮换单邮箱取码 Key", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"$ref": "#/components/parameters/MailboxID"}], "responses": {"201": {"description": "仅显示一次的 sam_mailbox_ Key"}}}},
    "/api/admin/jobs": {"get": {"tags": ["Admin"], "summary": "分页查询任务", "security": [{"adminSession": []}], "responses": {"200": {"description": "最近任务"}}}, "post": {"tags": ["Admin"], "summary": "创建任务", "security": [{"adminSession": [], "csrf": []}], "responses": {"202": {"description": "任务已入队"}}, "description": "mailbox.create 可指定 account_ids、count（1–100）、strategy、allocation_mode 和 purpose；mailbox.message_sync 可指定 account_id/account_ids 及 lookback_days（1–365，省略为增量同步）。"}, "delete": {"tags": ["Admin"], "summary": "取消执行并删除全部任务记录", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "全部记录已删除"}}}},
    "/api/admin/jobs/{job_id}": {"get": {"tags": ["Admin"], "summary": "读取任务", "security": [{"adminSession": []}], "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "任务详情"}}}},
    "/api/admin/jobs/{job_id}/cancel": {"post": {"tags": ["Admin"], "summary": "取消任务", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "已请求取消"}}}},
    "/api/admin/jobs/{job_id}/events": {"get": {"tags": ["Admin"], "summary": "读取任务事件", "security": [{"adminSession": []}], "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "任务事件列表"}}}},
    "/api/admin/schedules": {"get": {"tags": ["Admin"], "summary": "计划列表", "security": [{"adminSession": []}], "responses": {"200": {"description": "计划列表"}}}, "post": {"tags": ["Admin"], "summary": "新增计划", "security": [{"adminSession": [], "csrf": []}], "responses": {"201": {"description": "计划已创建"}}}},
    "/api/admin/schedules/{schedule_id}": {"parameters": [{"name": "schedule_id", "in": "path", "required": true, "schema": {"type": "string"}}], "get": {"tags": ["Admin"], "summary": "读取计划", "security": [{"adminSession": []}], "responses": {"200": {"description": "计划详情"}}}, "patch": {"tags": ["Admin"], "summary": "编辑计划", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "计划已更新"}}}, "delete": {"tags": ["Admin"], "summary": "删除计划", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "计划已删除"}}}},
    "/api/admin/schedules/{schedule_id}/run": {"post": {"tags": ["Admin"], "summary": "立即运行计划", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "schedule_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "计划任务已入队"}}}},
    "/api/admin/api-clients": {"get": {"tags": ["Admin"], "summary": "API 客户端列表", "security": [{"adminSession": []}], "responses": {"200": {"description": "客户端列表"}}}, "post": {"tags": ["Admin"], "summary": "创建 API 客户端", "security": [{"adminSession": [], "csrf": []}], "responses": {"201": {"description": "客户端与仅显示一次的 sam_live_ Key"}}}},
    "/api/admin/api-clients/{client_id}": {"parameters": [{"name": "client_id", "in": "path", "required": true, "schema": {"type": "string"}}], "patch": {"tags": ["Admin"], "summary": "更新 API 客户端状态", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "客户端已更新"}}}, "delete": {"tags": ["Admin"], "summary": "删除 API 客户端", "security": [{"adminSession": [], "csrf": []}], "responses": {"204": {"description": "客户端已删除"}}}},
    "/api/admin/api-clients/{client_id}/rotate": {"post": {"tags": ["Admin"], "summary": "轮换 API Key", "security": [{"adminSession": [], "csrf": []}], "parameters": [{"name": "client_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "仅显示一次的新 sam_live_ Key"}}}},
    "/api/admin/settings": {"get": {"tags": ["Admin"], "summary": "运行时设置", "security": [{"adminSession": []}], "responses": {"200": {"description": "消息留存设置"}}}, "put": {"tags": ["Admin"], "summary": "更新运行时设置", "security": [{"adminSession": [], "csrf": []}], "responses": {"200": {"description": "已保存"}}}},
