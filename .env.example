# 首次启动时创建的管理员用户名。
SAM_ADMIN_USERNAME=admin

# 首次启动时创建管理员所用的密码
SAM_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# 对外公开访问地址，用于生成页面中展示或复制的 API 地址；正式环境应使用 HTTPS。
SAM_PUBLIC_BASE_URL=https://mail.example.com

# 是否为登录 Cookie 添加 Secure 属性；通过 HTTPS 部署时应保持 true。
SAM_COOKIE_SECURE=true

# 管理员会话空闲超时时间，单位为分钟，允许范围为 5-43200。
SAM_SESSION_IDLE_MINUTES=720

# 管理员会话绝对有效期，单位为小时，允许范围为 1-8760。
SAM_SESSION_ABSOLUTE_HOURS=168

# 后台任务并发数，允许范围为 1-16。
SAM_WORKER_CONCURRENCY=3

# 可信反向代理网段，多个 CIDR 使用英文逗号分隔；不使用可信代理时留空。
SAM_TRUSTED_PROXY_CIDRS=
